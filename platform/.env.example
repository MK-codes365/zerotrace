# ZEROTrace — Environment Variables
# Copy this file to .env and customize

# ── App ──────────────────────────────────────────────
APP_NAME=ZEROTrace
DEBUG=false

# ── CRITICAL: Safety Mode ────────────────────────────
# Set to true for safe demo mode (no actual destructive operations)
SAFE_DEMO_MODE=true
REQUIRE_DOUBLE_CONFIRM=true

# ── Database ─────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://zerotrace:zerotrace_secret@postgres:5432/zerotrace
DATABASE_URL_SYNC=postgresql+psycopg2://zerotrace:zerotrace_secret@postgres:5432/zerotrace

# ── Redis ────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Auth ─────────────────────────────────────────────
# MUST be changed in production!
SECRET_KEY=CHANGE-ME-IN-PRODUCTION-USE-openssl-rand-hex-64
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=480

# ── Workers ──────────────────────────────────────────
MAX_WORKERS=4
CHUNK_SIZE_MB=256
WORKER_TIMEOUT_SECONDS=3600

# ── CORS ─────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ── Logging ──────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json
